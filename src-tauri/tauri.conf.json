{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gedoens",
  "version": "0.3.0",
  "identifier": "de.complioty.gedoens",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "gedoens",
        "width": 1040,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2OTk2MzQ3Njk3NkI0ODQKUldTRXRIWnBSMk9aMXNWR2prN2YyWE1WaFluVVZqZjdwUGE1aGxIeXFmVmROb3pmZzBuOGh4TjAK",
      "endpoints": [
        "https://github.com/philipempl/gedoens/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
